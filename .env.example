# 복사해서 .env 로 쓴다. 서버 시크릿은 서버 .env 에만 두고 레포에 커밋하지 않는다.
# Mac 서버: nginx(https) → ${WEB_BIND:-127.0.0.1}:${WEB_PORT} → 컨테이너. TRUST_PROXY/PROXY_FIX_HOPS=1.

APP_ENV=production
APP_VERSION=2.0.0

# --- 필수(없으면 기동 실패) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

POSTGRES_DB=wecarscan
POSTGRES_USER=wecarscan
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://wecarscan:비밀번호@db:5432/wecarscan
TEST_DATABASE_URL=postgresql+psycopg://wecarscan:비밀번호@db:5432/wecarscan_test

# --- 프록시·공개 URL (nginx 뒤 운영) ---
# TRUST_PROXY=1 또는 PROXY_FIX_HOPS=1 (기본). 로컬 직접 접속만이면 TRUST_PROXY=0
TRUST_PROXY=1
PROXY_FIX_HOPS=1
SESSION_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https
PUBLIC_BASE_URL=https://scan.example.com

# 포트 바인딩 (compose). 서버는 127.0.0.1 만 연다.
WEB_BIND=127.0.0.1
WEB_PORT=8000

# web 기동 전 flask db upgrade (Mac/prod 권장 1)
AUTO_DB_UPGRADE=1

JWT_TTL=60
JWT_REFRESH_TTL=20160

# 운영 Redis (compose.prod 기본). 로컬 개발은 memory://
RATELIMIT_STORAGE_URI=redis://redis:6379/0
ADMIN_LOGIN_RATE_LIMIT=5 per minute
API_LOGIN_RATE_LIMIT=20 per minute

# 차량정보 조회(선택)
CAR_INFO_API_URL=
CAR_INFO_API_KEY=

# 개발용 SMS 고정 코드(운영에서는 비움)
SMS_DEV_CODE=

# 최초 관리자(create-admin 한 번). 등록 후 지워도 됨.
ADMIN_TID=
ADMIN_PASSWORD=

# 프록시 홉 수 1단이면 PROXY_FIX_HOPS=1
# IMAGE_TAG=latest
