# 로컬 개발용 예시. 복사해서 .env 로 쓰고, 운영 비밀값은 배포 환경 변수로만 주입한다.
APP_ENV=development
APP_VERSION=2.0.0

# 32자 이상 임의 문자열: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
# Fernet 키(AI 키·OTP 비밀값 암호화). DB와 분리해 보관한다.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

POSTGRES_DB=wecarscan
POSTGRES_USER=wecarscan
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://wecarscan:비밀번호@db:5432/wecarscan
# 테스트 전용 DB (pytest)
TEST_DATABASE_URL=postgresql+psycopg://wecarscan:비밀번호@db:5432/wecarscan_test

JWT_TTL=60
JWT_REFRESH_TTL=20160

# 차량정보 조회(외부 API)
CAR_INFO_API_URL=
CAR_INFO_API_KEY=

# 개발 중에만: 설정하면 SMS를 보내지 않고 이 값을 인증번호로 쓴다. 운영에서는 비운다.
SMS_DEV_CODE=

# 최초 관리자: flask create-admin 이 한 번만 읽는다. 실제 값은 .env 에만 넣고, 등록 후에는 지워도 된다.
ADMIN_TID=
ADMIN_PASSWORD=

# 운영에서는 redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://
ADMIN_LOGIN_RATE_LIMIT=5 per minute
API_LOGIN_RATE_LIMIT=20 per minute

# HTTPS가 아닌 로컬에서는 false
SESSION_COOKIE_SECURE=false
PROXY_FIX_HOPS=1
