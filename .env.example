# Docker ports
FORWARD_WEB_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

APP_NAME=WecarScan
APP_ENV=local
APP_KEY=base64:RtrLStZAvTnYkoIgg5q12/nzr542zzqQBYkgh11DNJU=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=wecarscan-db
DB_PORT=3306
DB_DATABASE=wecarscan
DB_USERNAME=wecarscan
DB_PASSWORD=wecarscan123

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# JWT 토큰 서명에 사용되는 비밀 키
JWT_SECRET=P2qRCgGPEfwvlJI6ciOlJvG59socX2JP9tWPSFhyQGYpn82nnIabbF97kDr8gwfY
# JWT 토큰의 유효 기간 (분 단위)
JWT_TTL=60
# 리프레시 토큰의 유효 기간 (분 단위, 기본값 20160분 = 2주)
JWT_REFRESH_TTL=20160
# JWT 토큰 암호화 알고리즘 (HS256, RS256 등)
JWT_ALGO=HS256
# 블랙리스트 기능 활성화 여부 (토큰 무효화 기능)
JWT_BLACKLIST_ENABLED=true
# 블랙리스트 유예 기간 (초 단위)
JWT_BLACKLIST_GRACE_PERIOD=0
