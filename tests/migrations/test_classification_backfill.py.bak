"""Classification migration backfill test."""
import pytest
from sqlalchemy import text, create_engine
from alembic import command
from alembic.config import Config

from app import create_app
from app.extensions import db


@pytest.fixture(scope="module")
def alembic_config():
    """Alembic config for migrations."""
    config = Config("migrations/alembic.ini")
    config.set_main_option("script_location", "migrations")
    return config


def test_classification_migration_backfill():
    """Test classification migration with representative data.
    
    1. Create temporary Postgres database for migration testing
    2. Upgrade to c9f8d4e5a3b7 (before classification migration)
    3. Insert representative rows
    4. Upgrade to d7a3e8f6b2c9 (classification migration)
    5. Check backfilled classifications
    6. Upgrade to head and cleanup
    """
    import os
    from sqlalchemy.engine.url import make_url
    
    base_url = os.environ.get("TEST_DATABASE_URL")
    if not base_url:
        pytest.skip("TEST_DATABASE_URL not set (PostgreSQL required)")
    
    # Create a temporary database for this test
    url = make_url(base_url)
    admin_db_url = url.set(database="postgres")
    test_db_name = "scantest_migration_test"
    
    # Create test database
    admin_engine = create_engine(admin_db_url, isolation_level="AUTOCOMMIT")
    with admin_engine.connect() as admin_conn:
        # Drop if exists and create fresh
        admin_conn.execute(text(f"DROP DATABASE IF EXISTS {test_db_name}"))
        admin_conn.execute(text(f"CREATE DATABASE {test_db_name}"))
    admin_engine.dispose()
    
    # Use the test database
    db_url = url.set(database=test_db_name).render_as_string(hide_password=False)
    
    # Set environment variable so migrations use the correct database
    old_db_url = os.environ.get("TEST_DATABASE_URL")
    os.environ["TEST_DATABASE_URL"] = db_url
    
    try:
        engine = create_engine(db_url)
        
        # Create Flask app with the migration database
        app = create_app("testing")
        
        with app.app_context():
            # Configure alembic to use the test database
            config = Config("migrations/alembic.ini")
            config.set_main_option("script_location", "migrations")
            config.set_main_option("sqlalchemy.url", db_url)
            
            # Upgrade to c9f8d4e5a3b7 (just before classification migration)
            command.upgrade(config, "c9f8d4e5a3b7")
            
            # Now work with the database
            conn = engine.connect()
    
        # Insert representative data
        conn.execute(text("""
            INSERT INTO definition_sources (id, source_type, file_path, sha256, file_size, imported_at)
            VALUES 
            (9001, 'dbc', 'test/hyundai_egmp_can.dbc', '0123456789abcdef' || repeat('0', 48), 1024, CURRENT_TIMESTAMP),
            (9002, 'obdb', 'test/hyundai_ioniq5_pids.json', '1234567890abcdef' || repeat('0', 48), 2048, CURRENT_TIMESTAMP),
            (9003, 'wican', 'test/kia_ev6_commands.json', '234567890abcdef0' || repeat('0', 48), 1536, CURRENT_TIMESTAMP)
            """))
            
            conn.execute(text("""
            INSERT INTO vehicle_definitions (id, source_id, maker, model, year_from, created_at)
            VALUES
            (9001, 9001, 'Hyundai', 'IONIQ 6', 2023, CURRENT_TIMESTAMP),
            (9002, 9001, 'Hyundai', 'TUCSON HYBRID', 2022, CURRENT_TIMESTAMP),
            (9003, 9001, 'Kia', 'EV6', 2022, CURRENT_TIMESTAMP),
            (9004, 9001, 'Tesla', 'MODEL 3', 2023, CURRENT_TIMESTAMP),
            (9005, 9001, 'Hyundai', 'SONATA PLUG-IN', 2021, CURRENT_TIMESTAMP),
            (9006, 9001, 'Generic', 'UNKNOWN CAR', NULL, CURRENT_TIMESTAMP)
            """))
            
            conn.execute(text("""
            INSERT INTO dbc_messages (id, source_id, can_id, message_name, dlc)
            VALUES
            (9001, 9001, 2020, 'BMS_Status', 8),
            (9002, 9001, 2021, 'Motor_Status', 8)
            """))
            
            conn.execute(text("""
            INSERT INTO dbc_signals (id, message_id, signal_name, start_bit, bit_length, byte_order, value_type, factor, offset)
            VALUES
            (9001, 9001, 'Battery_SOC', 0, 16, 'little', 'unsigned', 0.1, 0),
            (9002, 9001, 'Battery_SOH', 16, 16, 'little', 'unsigned', 0.1, 0),
            (9003, 9001, 'Cell_Voltage_01', 32, 16, 'little', 'unsigned', 0.001, 0),
            (9004, 9001, 'Pack_Voltage', 48, 16, 'little', 'unsigned', 0.1, 0),
            (9005, 9002, 'Motor_Torque', 0, 16, 'little', 'signed', 0.1, 0),
            (9006, 9002, 'Vehicle_Speed', 16, 16, 'little', 'unsigned', 0.01, 0)
            """))
            
            conn.execute(text("""
            INSERT INTO diagnostic_commands (
                id, source_id, source_type, maker, model, ecu_address, ecu_name,
                service, pid, command_bytes, label, formula, unit,
                verification_status, verification_count, success_count, failure_count,
                created_at, updated_at
            ) VALUES
            (9001, 9002, 'obdb', 'Hyundai', 'IONIQ 5', '7E4', 'BMS', '22', '0105', '220105', 
             'Battery SOC', 'A*0.5', '%', 'needs_verification', 0, 0, 0, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
            (9002, 9002, 'obdb', 'Hyundai', 'IONIQ 5', '7E4', 'BMS', '22', '0101', '220101',
             'Battery SOH', 'A', '%', 'needs_verification', 0, 0, 0, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
            (9003, 9003, 'wican', 'Kia', 'EV6', '7E2', 'Motor Control Unit', '22', '1001', '221001',
             'Motor RPM', 'A*10', 'rpm', 'needs_verification', 0, 0, 0, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
            (9004, 9002, 'obdb', NULL, NULL, '7DF', 'ECM', '01', '0C', '010C',
             'Engine RPM', '((A*256)+B)/4', 'rpm', 'needs_verification', 0, 0, 0, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
            """))
            
            conn.commit()
            
            # Upgrade to d7a3e8f6b2c9 (classification migration)
            command.upgrade(config, "d7a3e8f6b2c9")
            
            # Check backfilled classifications
            # 1. Check vehicle powertrains
            result = conn.execute(text("""
            SELECT model, powertrain FROM vehicle_definitions WHERE id BETWEEN 9001 AND 9006 ORDER BY id
            """))
            powertrains = {row[0]: row[1] for row in result}
            
            assert powertrains['IONIQ 6'] == 'BEV', "IONIQ 6 should be BEV"
            assert powertrains['EV6'] == 'BEV', "EV6 should be BEV"
            assert powertrains['MODEL 3'] == 'BEV', "MODEL 3 should be BEV"
            assert powertrains['TUCSON HYBRID'] == 'HEV', "TUCSON HYBRID should be HEV"
            assert powertrains['SONATA PLUG-IN'] == 'PHEV', "SONATA PLUG-IN should be PHEV"
            assert powertrains['UNKNOWN CAR'] == 'unknown', "Unknown car should be 'unknown'"
            
            # 2. Check DBC signal classifications
            result = conn.execute(text("""
            SELECT signal_name, protocol, ecu_module, signal_category 
            FROM dbc_signals WHERE id BETWEEN 9001 AND 9006 ORDER BY id
            """))
            signals = {row[0]: {'protocol': row[1], 'ecu': row[2], 'category': row[3]} for row in result}
            
            assert signals['Battery_SOC']['protocol'] == 'CAN', "All DBC signals should be CAN"
            assert signals['Battery_SOC']['ecu'] == 'BMS', "Battery_SOC should be BMS"
            assert signals['Battery_SOC']['category'] == 'battery_soc', "Battery_SOC category"
            
            assert signals['Battery_SOH']['ecu'] == 'BMS'
            assert signals['Battery_SOH']['category'] == 'battery_soh'
            
            assert signals['Cell_Voltage_01']['ecu'] == 'BMS'
            assert signals['Cell_Voltage_01']['category'] == 'cell_voltage'
            
            assert signals['Pack_Voltage']['ecu'] == 'BMS'
            assert signals['Pack_Voltage']['category'] == 'battery_voltage'
            
            assert signals['Motor_Torque']['ecu'] == 'MCU'
            assert signals['Motor_Torque']['category'] == 'drive_torque'
            
            assert signals['Vehicle_Speed']['category'] == 'drive_speed'
            
            # 3. Check diagnostic command classifications
            result = conn.execute(text("""
            SELECT label, protocol, ecu_module 
            FROM diagnostic_commands WHERE id BETWEEN 9001 AND 9004 ORDER BY id
            """))
            commands = {row[0]: {'protocol': row[1], 'ecu': row[2]} for row in result}
            
            assert commands['Battery SOC']['protocol'] == 'UDS', "Service 22 should be UDS"
            assert commands['Battery SOC']['ecu'] == 'BMS', "Battery commands should be BMS"
            
            assert commands['Battery SOH']['protocol'] == 'UDS'
            assert commands['Battery SOH']['ecu'] == 'BMS'
            
            assert commands['Motor RPM']['protocol'] == 'UDS'
            assert commands['Motor RPM']['ecu'] == 'MCU', "Motor should be MCU"
            
            assert commands['Engine RPM']['protocol'] == 'OBD-II', "Service 01 should be OBD-II"
            assert commands['Engine RPM']['ecu'] == 'ECM', "Engine should be ECM"
    
                # Upgrade to head to ensure no issues
            command.upgrade(config, "head")
            
            conn.close()
        
        engine.dispose()
    finally:
        # Restore original environment variable
        if old_db_url:
            os.environ["TEST_DATABASE_URL"] = old_db_url
        elif "TEST_DATABASE_URL" in os.environ:
            del os.environ["TEST_DATABASE_URL"]
    
    # Drop the temporary test database
    admin_engine = create_engine(admin_db_url, isolation_level="AUTOCOMMIT")
    with admin_engine.connect() as admin_conn:
        admin_conn.execute(text(f"DROP DATABASE IF EXISTS {test_db_name}"))
    admin_engine.dispose()
