{
  "name": "wecarscan-assets",
  "private": true,
  "description": "관리자 화면 CSS 빌드(Tailwind CSS)",
  "scripts": {
    "build:css": "tailwindcss -i app/static/css/app.css -o app/static/dist/app.css --minify",
